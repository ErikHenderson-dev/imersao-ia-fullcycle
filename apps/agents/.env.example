# Copie para .env (ignorado pelo git). O compose lê este arquivo no serviço agents.
# As variáveis sem segredo ficam no compose.yaml (LLD, "Valores e configuração").

# Chave do Gemini pelo Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo dos Agentes: AGENT_MODEL=gemini-3.8-flash, o padrão, fica no compose.yaml, que vence este
# arquivo. Para trocar, suba com a variável no ambiente:
#   AGENT_MODEL=openai/<modelo> docker compose -f compose.yaml up -d agents
# openai/… e anthropic/… exigem a chave abaixo; sem ela, o Serviço de agentes não sobe.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CHAT_API_URL e CHAT_BOT_TOKEN (a API do chat e a credencial de bot das rotas /v1/bot) vêm do
# compose.yaml, como a credencial de serviço.
